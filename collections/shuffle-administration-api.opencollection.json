{
  "opencollection": "1.0.0",
  "info": {
    "name": "Shuffle Administration API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Administration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Environments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://shuffler.io/api/v1/getenvironments"
          },
          "docs": "Returns all execution environments (workers) configured for the organization."
        }
      ]
    }
  ],
  "bundled": true
}